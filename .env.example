# ==============================================================================
# Workplace Ally — Google Cloud Free Tier Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud / Firebase Backend (Free Tier)
# ------------------------------------------------------------------------------
# Client-side Firebase Configuration (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="ai-workplace-ally.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ai-workplace-ally"
VITE_FIREBASE_STORAGE_BUCKET="ai-workplace-ally.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server-side Firebase / GCP Admin (Optional: Cloud Run detects ADC automatically)
# In local dev or CI, paste your Service Account Key JSON string or path
FIREBASE_PROJECT_ID="ai-workplace-ally"
FIREBASE_SERVICE_ACCOUNT_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ------------------------------------------------------------------------------
# 2. AI Model Providers (GitHub Models / Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Option A: GitHub Models (Recommended for GitHub Actions / Codespaces)
GITHUB_TOKEN=""
GITHUB_AI_MODEL="gpt-4o-mini"

# Option B: Google Gemini API (Get key at https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Option C: OpenAI API (Get key at https://platform.openai.com)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. Optional Integrations
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_API_KEY=""
FIREFLIES_API_KEY=""
